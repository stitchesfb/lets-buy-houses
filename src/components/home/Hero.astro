---
/**
 * Opening screen: a full-bleed residential photograph, the service-area line, one
 * headline, and the two primary paths. Her name, team and brokerage live in the header.
 * A restrained corner gradient keeps the text readable without darkening the whole photo.
 */
import Photo from '@/components/ui/Photo.astro';
import { photo } from '@/data/photos';
import { withBase } from '@/lib/paths';

const hero = photo('home-hero');
---

<section class="on-dark relative isolate flex min-h-[78svh] items-end overflow-hidden bg-navy text-white lg:min-h-[82vh]">
  <div class="absolute inset-0 -z-10">
    <Photo photo={hero} eager sizes="100vw" widths={[640, 1024, 1600, 2400]} />
    <!-- Gradient only behind the headline and buttons -->
    <div class="absolute inset-x-0 bottom-0 h-[70%] bg-gradient-to-t from-navy/90 via-navy/50 to-transparent sm:hidden"></div>
    <div class="absolute inset-0 hidden bg-[radial-gradient(ellipse_75%_85%_at_0%_100%,rgb(20_40_63/0.88)_0%,rgb(20_40_63/0.6)_40%,rgb(20_40_63/0)_75%)] sm:block"></div>
  </div>

  <div class="container-page w-full pt-28 pb-12 sm:pb-16 lg:pb-20">
    <p class="text-xs font-semibold tracking-[0.16em] text-white/90 uppercase sm:text-sm">Ocean &amp; Monmouth Counties, NJ</p>
    <h1 class="mt-4 max-w-2xl text-[2.5rem] leading-[1.06] !text-white sm:text-5xl lg:text-6xl">Your next chapter starts at home.</h1>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={withBase('/buy/')} class="btn-light text-lg">Find a Home</a>
      <a href={withBase('/sell/')} class="btn-ghost-light text-lg backdrop-blur-sm">Sell My Home</a>
    </div>
  </div>
</section>
