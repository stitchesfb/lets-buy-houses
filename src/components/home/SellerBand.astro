---
/** Concise photographic seller invitation; the form itself lives on /sell/. */
import Photo from '@/components/ui/Photo.astro';
import { photo } from '@/data/photos';
import { withBase } from '@/lib/paths';
---

<section class="on-dark relative isolate overflow-hidden bg-navy text-white" aria-labelledby="seller-band-heading">
  <div class="absolute inset-0 -z-10">
    <Photo photo={photo('seller-band')} sizes="100vw" widths={[640, 1024, 1600, 2400]} />
    <div class="absolute inset-0 bg-gradient-to-r from-navy/90 via-navy/60 to-navy/10"></div>
  </div>
  <div class="container-page py-20 sm:py-28">
    <div class="max-w-xl">
      <p class="eyebrow !text-gold">Selling</p>
      <h2 id="seller-band-heading" class="mt-3 text-4xl !text-white sm:text-5xl">Thinking About Selling?</h2>
      <p class="mt-5 text-lg text-white/85">
        I’ll walk through your home with you, review recent nearby sales, and talk through pricing and timing. It’s a personal review,
        not an online estimate.
      </p>
      <a href={withBase('/sell/#home-value')} class="btn-light mt-8">Request a Home Value Review</a>
    </div>
  </div>
</section>
