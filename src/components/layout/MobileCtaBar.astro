---
/**
 * Compact contact bar on phones. The layout adds matching bottom padding
 * (see BaseLayout) so it never covers page content or form controls.
 */
import { site } from '@/data/site';
import { ui } from '@/i18n/en';
import { withBase } from '@/lib/paths';

const items = [
  { label: ui.contactBar.call, href: site.contact.phoneHref, icon: 'M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z' },
  { label: ui.contactBar.text, href: site.contact.smsHref, icon: 'M4 5h16v11H8l-4 4V5Z' },
  { label: ui.contactBar.contact, href: withBase('/contact/'), icon: 'M4 6h16v12H4zM4 7l8 6 8-6' },
];
---

<nav
  aria-label="Quick contact"
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-line bg-white pb-[env(safe-area-inset-bottom)] md:hidden"
>
  {
    items.map((item, i) => (
      <a
        href={item.href}
        class:list={[
          'flex min-h-14 items-center justify-center gap-2 text-[0.9375rem] font-semibold',
          i === 2 ? 'bg-navy text-white' : 'text-navy',
          i === 1 && 'border-x border-line',
        ]}
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
          <path d={item.icon} />
        </svg>
        {item.label}
      </a>
    ))
  }
</nav>
