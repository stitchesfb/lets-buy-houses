---
import { towns } from '@/data/towns';

interface Props {
  heading?: string;
  /** Hide the current town when used on a town page. */
  exclude?: string;
}
const { heading = 'Explore the Towns I Know Best', exclude } = Astro.props;
const list = towns.filter((t) => t.slug !== exclude);
---

<section class="section bg-sand-50" aria-labelledby="towns-heading">
  <div class="container-page">
    <p class="eyebrow">Communities</p>
    <h2 id="towns-heading" class="mt-2 text-3xl sm:text-4xl">{heading}</h2>
    <div class:list={['mt-10 grid gap-6 sm:grid-cols-2', list.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
      {
        list.map((t) => (
          <a
            href={`/${t.slug}/`}
            class="group relative isolate flex aspect-[4/3] flex-col sm:aspect-[4/5] justify-end overflow-hidden rounded-2xl p-6 text-white shadow-lg ring-1 ring-black/5 transition hover:-translate-y-1 hover:shadow-2xl"
          >
            <img src={t.cardImage} alt="" loading="lazy" width="800" height="600" class="absolute inset-0 -z-10 h-full w-full object-cover transition duration-500 group-hover:scale-105" />
            <div class="absolute inset-0 -z-10 bg-gradient-to-t from-brand-900/90 via-brand-900/30 to-transparent" />
            <p class="text-xs font-semibold tracking-widest text-accent-400 uppercase">{t.county} County</p>
            <h3 class="mt-1 text-2xl !text-white">{t.name}, NJ</h3>
            <p class="mt-1 text-sm text-brand-100">{t.angle}</p>
            <span class="mt-4 text-sm font-semibold">View homes &amp; market data →</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
