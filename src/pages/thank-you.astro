---
/** Conversion page — use as the goal URL in Google Ads / GA4. Not indexed. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/paths';
import { site } from '@/data/site';
---

<BaseLayout title={`Thank You | ${site.brand}`} description="Your request was received." noindex>
  <section class="container-page py-24 text-center">
    <p class="text-5xl" aria-hidden="true">🏡</p>
    <h1 class="mt-4 text-4xl font-bold">Thank You — I'll Be in Touch Shortly!</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-slate-600">
      Your request is on its way to {site.agent.name}. Need something sooner? Call or text
      <a href={site.contact.phoneHref} class="font-semibold text-brand-600">{site.contact.phone}</a>.
    </p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href={withBase('/search/')} class="btn-primary">Browse Homes</a>
      {site.social.youtube && <a href={site.social.youtube} class="btn-secondary" rel="noopener" target="_blank">Watch Local Videos</a>}
    </div>
  </section>
</BaseLayout>
