---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Steps from '@/components/ui/Steps.astro';
import AwaitingContent from '@/components/ui/AwaitingContent.astro';
import SellerInvite from '@/components/home/SellerInvite.astro';
import RenovationInsight from '@/components/sell/RenovationInsight.astro';
import { breadcrumbSchema } from '@/lib/schema';
import { affiliation, site } from '@/data/site';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Sell', url: '/sell/' },
];

const steps = [
  {
    title: 'Walk through your home together',
    body: 'I’ll visit, listen to your goals and timing, and point out what buyers are likely to notice first.',
  },
  {
    title: 'Prepare it to show well',
    body: 'I’ll give you practical suggestions on repairs, decluttering, and presentation, focused on what’s worth doing before you list.',
  },
  {
    title: 'Price it with care',
    body: 'We’ll review recent sales of similar homes nearby and the current competition, then choose a list price and strategy together.',
  },
  {
    title: 'Market it to buyers',
    body: 'I plan how your home will be presented online and to buyers’ agents, and I coordinate showings around your schedule.',
  },
  {
    title: 'Negotiate the best terms',
    body: 'When offers arrive, I’ll walk you through price, terms, and contingencies and negotiate for the strongest possible outcome.',
  },
  {
    title: 'Close smoothly',
    body: 'I keep inspections, appraisal, and attorney review on track and keep you informed until the closing is complete.',
  },
];
---

<BaseLayout
  title={`Selling Your Home in Toms River, Brick & Ocean County, NJ | ${site.agent.legalName}`}
  description={`Request a personal home value review and learn how Jacquelyn Guevara of ${affiliation} prepares, prices, and markets homes in Ocean and Monmouth County, NJ.`}
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHeader
    crumbs={crumbs}
    eyebrow="Selling Your Home"
    title="Sell with a plan, and someone in your corner"
    intro="From the first walkthrough to closing day, I’ll help you prepare, price, and market your home, then negotiate hard on your behalf."
  >
    <a href="#home-value" class="btn-primary">Request a Home Value Review</a>
    <a href={site.contact.phoneHref} class="btn-outline">Call {site.contact.phone}</a>
  </PageHeader>

  <section class="section" aria-labelledby="sell-steps-heading">
    <div class="container-page">
      <SectionHeading id="sell-steps-heading" eyebrow="The Process" title="How selling with me works" />
      <div class="mt-12"><Steps steps={steps} /></div>
      <div class="mt-12">
        <AwaitingContent title="Jacquelyn’s specific marketing services">
          <p>
            List the services Jacquelyn provides for every listing (for example photography, video, open houses, or specific
            online channels) so this page can describe them exactly. Shown in preview only.
          </p>
        </AwaitingContent>
      </div>
    </div>
  </section>

  <RenovationInsight />

  <SellerInvite formId="sell-home-value" />

  <section class="py-12 sm:py-14" aria-label="Talk with me">
    <div class="container-page flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <h2 class="text-2xl sm:text-3xl">Prefer to talk it through first?</h2>
        <p class="mt-2 text-muted">Call or text me directly. There’s no obligation to list.</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href={site.contact.phoneHref} class="btn-primary">Call {site.contact.phone}</a>
        <a href={site.contact.smsHref} class="btn-outline">Text Me</a>
      </div>
    </div>
  </section>
</BaseLayout>
