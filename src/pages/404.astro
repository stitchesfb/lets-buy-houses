---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CommunityGrid from '@/components/home/CommunityGrid.astro';
import { withBase } from '@/lib/paths';
---

<BaseLayout title="Page Not Found" description="The page you were looking for could not be found." noindex>
  <section class="container-page py-20 text-center">
    <p class="eyebrow">Page not found</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">This page has moved on</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-muted">The page you’re looking for doesn’t exist. Try one of these instead.</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href={withBase('/')} class="btn-primary">Go to the Homepage</a>
      <a href={withBase('/contact/')} class="btn-outline">Contact Jacquelyn</a>
    </div>
  </section>
  <CommunityGrid heading="Explore communities" />
</BaseLayout>
