---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TownGrid from '@/components/home/TownGrid.astro';
---

<BaseLayout title="Page Not Found" description="The page you were looking for could not be found." noindex>
  <section class="container-page py-20 text-center">
    <h1 class="text-4xl font-bold">This Listing Has Moved</h1>
    <p class="mt-3 text-lg text-slate-600">The page you're looking for doesn't exist — but your next home might be below.</p>
    <a href="/search/" class="btn-primary mt-8">Search All Homes</a>
  </section>
  <TownGrid heading="Popular Communities" />
</BaseLayout>
