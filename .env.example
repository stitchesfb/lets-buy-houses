# Copy to .env and fill in. Only PUBLIC_* vars are exposed to the browser.

# ---- Site mode --------------------------------------------------------------
# preview (default): shows labeled sample listings and "awaiting content" notes.
# production: hides every sample and placeholder.
PUBLIC_SITE_MODE=preview

# ---- Lead forms -------------------------------------------------------------
# Any endpoint that accepts a form POST and answers JSON (Formspree, Basin, a CRM
# webhook). The service decides where submissions are emailed. Leave blank and
# forms stay clearly marked "preview only"; nothing is sent.
PUBLIC_FORM_ENDPOINT=

# ---- IDX / MLS search -------------------------------------------------------
# One of: placeholder | idx-broker | iframe | script
PUBLIC_IDX_PROVIDER=placeholder

# IDX Broker: your account subdomain, e.g. https://letsbuyhouses.idxbroker.com
PUBLIC_IDX_BROKER_DOMAIN=

# Generic hosted search page (iframe provider), e.g. a SimplyRETS/Showcase IDX/iHomefinder URL.
# Tokens: {city} = first city name, {cities} = city[]=A&city[]=B (one per MLS spelling)
PUBLIC_IDX_IFRAME_URL=

# Query param name for each city (default city[]). Some vendors use `city` or `cities`.
PUBLIC_IDX_CITY_PARAM=

# Generic widget script (script provider)
PUBLIC_IDX_SCRIPT_SRC=

# ---- Analytics (optional) ---------------------------------------------------
PUBLIC_GA_MEASUREMENT_ID=
