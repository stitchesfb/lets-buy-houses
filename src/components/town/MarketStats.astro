---
import AwaitingContent from '@/components/ui/AwaitingContent.astro';
import type { Town } from '@/data/towns';

interface Props {
  town: Town;
}
const { town } = Astro.props;
// Only real figures are shown; 'TBD' placeholders count as missing.
const stats = town.marketStats.stats.filter((s) => s.value && s.value !== 'TBD');
---

<section aria-labelledby="market-heading">
  <h2 id="market-heading" class="text-3xl">The {town.name} market</h2>
  <p class="mt-4 text-lg">{town.marketOverview}</p>
  {
    stats.length > 0 ? (
      <>
        <dl class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
          {stats.map((s) => (
            <div class="card flex flex-col p-5 text-center">
              <dt class="text-sm text-muted">{s.label}</dt>
              <dd class="order-first font-serif text-3xl text-navy">{s.value}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-3 text-sm text-muted">Source: MLS data, {town.marketStats.asOf}.</p>
      </>
    ) : (
      <div class="mt-6">
        <AwaitingContent title={`${town.name} market statistics`}>
          <p>Median price, days on market, and inventory from the MLS, updated monthly. Hidden on the live site until real figures are added.</p>
        </AwaitingContent>
      </div>
    )
  }
</section>
