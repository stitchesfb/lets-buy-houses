---
/**
 * Featured properties (up to three). Real listings from src/data/listings.ts;
 * preview builds show labeled samples when there are none. With no real
 * listings the section is omitted from the live site.
 */
import ListingCard from '@/components/listings/ListingCard.astro';
import { featuredListings } from '@/lib/listings';
import { withBase } from '@/lib/paths';

const items = featuredListings().slice(0, 3);
const isDemo = items.length > 0 && items.every((l) => l.demo);
---

{
  items.length > 0 && (
    <section class="pt-4 pb-16 sm:pt-6 sm:pb-24" aria-labelledby="listings-heading">
      <div class="container-page">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="eyebrow">Featured Properties</p>
            <h2 id="listings-heading" class="mt-3 text-3xl sm:text-4xl">Homes Jacquelyn is featuring</h2>
          </div>
          <a href={withBase('/buy/#home-search')} class="font-semibold text-navy underline decoration-gold underline-offset-8 hover:decoration-navy">
            Browse all listings <span aria-hidden="true">→</span>
          </a>
        </div>
        {isDemo && (
          <p class="mt-6 border-l-2 border-gold pl-4 text-sm text-muted">
            <strong class="text-ink">Preview:</strong> demonstration cards showing the layout. Not real properties; never shown on the live site.
          </p>
        )}
        <div class="mt-10 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((l) => <ListingCard listing={l} />)}
        </div>
      </div>
    </section>
  )
}
