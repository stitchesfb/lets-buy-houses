---
/**
 * Before-and-after renovation projects. Shows real projects from
 * src/data/transformations.ts; with none, preview builds show labeled
 * placeholder cards and the live site hides the section entirely.
 */
import { Picture } from 'astro:assets';
import Photo from '@/components/ui/Photo.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { transformations } from '@/data/transformations';
import { isPreview } from '@/lib/mode';
import { withBase } from '@/lib/paths';

const projects = transformations;
const showPlaceholders = projects.length === 0 && isPreview;
const placeholders = ['Kitchen update', 'Whole-home refresh', 'Curb appeal and exterior'];
const cta = withBase('/contact/?interest=Selling');
---

{
  (projects.length > 0 || showPlaceholders) && (
    <section class="section bg-ivory-deep" aria-labelledby="transformations-heading">
      <div class="container-page">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <SectionHeading
            id="transformations-heading"
            eyebrow="Home Transformations"
            title="Seeing a home’s potential"
            intro="A look at renovation and resale projects Jacquelyn has managed, from the first walkthrough to the finished home."
          />
          <a href={cta} class="btn-primary self-start md:self-auto">Discuss Your Home’s Potential</a>
        </div>

        {showPlaceholders && (
          <p class="mt-8 rounded-md border border-dashed border-gold-700/60 bg-gold-200/40 p-4 text-sm">
            <strong>Preview only:</strong> placeholder cards show the layout. Add real projects with before-and-after photos in{' '}
            <code class="text-xs">src/data/transformations.ts</code>. This section stays hidden on the live site until then.
          </p>
        )}

        <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {projects.map((p) => (
            <li class="card overflow-hidden">
              <div class="grid grid-cols-2 gap-px bg-line">
                {[['Before', p.before], ['After', p.after]].map(([label, img]) => (
                  <figure class="relative aspect-[4/3] overflow-hidden bg-white">
                    {img ? (
                      <Picture src={img as ImageMetadata} alt={`${label} photo: ${p.title}`} widths={[320, 640]} sizes="(min-width: 1024px) 15vw, 45vw" formats={['avif', 'webp']} class="h-full w-full object-cover" />
                    ) : (
                      <Photo label={`${label} photo coming`} />
                    )}
                    <figcaption class="absolute top-2 left-2 rounded bg-navy px-2 py-0.5 text-xs font-semibold text-white">{label}</figcaption>
                  </figure>
                ))}
              </div>
              <div class="p-5">
                {p.town && <p class="text-xs font-semibold tracking-[0.16em] text-muted uppercase">{p.town}</p>}
                <h3 class="mt-1 text-2xl">{p.title}</h3>
                <p class="mt-2 text-muted">{p.summary}</p>
                {p.scope && (
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {p.scope.map((s) => <li class="rounded-full border border-gold/60 px-3 py-1 text-xs font-semibold text-gold-700">{s}</li>)}
                  </ul>
                )}
              </div>
            </li>
          ))}

          {showPlaceholders &&
            placeholders.map((title) => (
              <li class="card overflow-hidden border-dashed">
                <div class="grid grid-cols-2 gap-px bg-line">
                  {['Before', 'After'].map((label) => (
                    <div class="relative aspect-[4/3] overflow-hidden">
                      <Photo label="Placeholder" />
                      <span class="absolute top-2 left-2 rounded bg-navy px-2 py-0.5 text-xs font-semibold text-white">{label}</span>
                    </div>
                  ))}
                </div>
                <div class="p-5">
                  <p class="text-xs font-semibold tracking-[0.16em] text-gold-700 uppercase">Placeholder · project photos coming</p>
                  <h3 class="mt-1 text-2xl">{title}</h3>
                  <p class="mt-2 text-muted">A short description of the plan, the work, and the result will go here.</p>
                </div>
              </li>
            ))}
        </ul>
      </div>
    </section>
  )
}
