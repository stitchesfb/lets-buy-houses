---
/**
 * Featured properties. Shows real listings from src/data/listings.ts.
 * With none: preview shows labeled samples; production shows an invitation
 * to let Jackie search instead of an empty grid.
 */
import ListingCard from '@/components/listings/ListingCard.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { featuredListings } from '@/lib/listings';
import { withBase } from '@/lib/paths';

const items = featuredListings();
const isDemo = items.length > 0 && items.every((l) => l.demo);
---

<section class="section" aria-labelledby="listings-heading">
  <div class="container-page">
    {
      items.length > 0 ? (
        <>
          <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
            <SectionHeading id="listings-heading" eyebrow="Featured Properties" title="Homes Jackie is featuring" />
            <a href={withBase('/buy/')} class="btn-outline self-start md:self-auto">Help Me Find a Home</a>
          </div>
          {isDemo && (
            <p class="mt-8 rounded-md border border-dashed border-gold-700/60 bg-gold-200/40 p-4 text-sm">
              <strong>Preview:</strong> these are demonstration cards to show the layout. They are not real properties, have no
              inquiry button, and never appear on the live site.
            </p>
          )}
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {items.map((l) => <ListingCard listing={l} />)}
          </div>
        </>
      ) : (
        <div class="card grid items-center gap-6 p-8 sm:p-10 md:grid-cols-[1fr_auto]">
          <div>
            <p class="eyebrow">Looking for a home?</p>
            <h2 id="listings-heading" class="mt-3 text-3xl">Let Jackie search for you</h2>
            <p class="mt-3 max-w-2xl text-muted">
              Tell Jackie what you’re looking for (the town, the price range, the must-haves) and she’ll send homes that fit.
            </p>
          </div>
          <a href={withBase('/buy/#buyer-inquiry')} class="btn-primary">Start My Home Search</a>
        </div>
      )
    }
  </div>
</section>
