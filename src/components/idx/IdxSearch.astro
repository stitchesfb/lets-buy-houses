---
/**
 * IDX / MLS search container.
 *
 * One component, every provider. Drop it anywhere:
 *   <IdxSearch />                               // all markets
 *   <IdxSearch city="Brick" heading="..." />    // pre-filtered to a town
 *   <IdxSearch city={['Manahawkin', 'Stafford Township']} town="Manahawkin" />
 *
 * Performance: third-party IDX code is the #1 thing that slows real estate
 * sites down, so iframes use loading="lazy" and vendor scripts are injected
 * only when the container scrolls near the viewport.
 */
import { idxConfig, idxSearchUrl, toCityList, type IdxCity } from '@/lib/idx';
import { isPreview } from '@/lib/mode';
import { withBase } from '@/lib/paths';

interface Props {
  city?: IdxCity;
  /** Display name for headings/labels; defaults to the first city. */
  town?: string;
  heading?: string;
  /** Vendor-specific widget ID (script provider), e.g. a per-town saved search widget. */
  widgetId?: string;
  minHeight?: number;
  /** Live listings on her RE/MAX site, shown while no IDX widget is connected. */
  listingsUrl?: string;
}

const { city, heading, widgetId, minHeight = 720, listingsUrl } = Astro.props;
const town = Astro.props.town ?? toCityList(city)[0];
const { provider, scriptSrc } = idxConfig;
const url = idxSearchUrl(city);
const label = town ? `${town}, NJ` : 'Ocean & Monmouth County';
const connected = ((provider === 'iframe' || provider === 'idx-broker') && Boolean(url)) || (provider === 'script' && Boolean(scriptSrc));
---

<section class="card p-4 sm:p-6" aria-label={`Search homes for sale in ${label}`}>
  {heading && <h2 class="mb-5 text-2xl sm:text-3xl">{heading}</h2>}

  {
    connected && (provider === 'iframe' || provider === 'idx-broker') ? (
      <iframe
        src={url}
        title={`Homes for sale in ${label}`}
        loading="lazy"
        class="w-full rounded-md border-0"
        style={`min-height:${minHeight}px`}
        referrerpolicy="no-referrer-when-downgrade"
      />
    ) : connected ? (
      <div
        class="idx-widget"
        data-idx-src={scriptSrc}
        data-idx-widget={widgetId}
        data-idx-city={toCityList(city).join(',') || undefined}
        style={`min-height:${minHeight}px`}
      >
        <p class="p-8 text-center text-muted">Loading listings…</p>
      </div>
    ) : (
      <div class="grid items-center gap-6 rounded-md bg-ivory p-6 sm:p-8 md:grid-cols-[1fr_auto]">
        <div>
          <p class="font-serif text-2xl text-navy">Looking for homes in {label}?</p>
          <p class="mt-2 max-w-xl text-muted">
            {listingsUrl
              ? 'Browse every current MLS listing on Jacquelyn’s RE/MAX Revolution search, or tell her your must-haves and she’ll send homes that match.'
              : 'Tell Jacquelyn your must-haves and price range, and she’ll send you homes for sale that match, including new listings as they come up.'}
          </p>
          {isPreview && (
            <p class="mt-3 text-sm text-gold-700">
              Preview note: a live MLS search can appear here once an IDX provider is approved and connected
              (see docs/IDX-INTEGRATION.md).
            </p>
          )}
        </div>
        <div class="flex flex-col gap-3">
          {listingsUrl && (
            <a href={listingsUrl} class="btn-primary" target="_blank" rel="noopener">
              Browse Current Listings<span class="sr-only"> (opens Jacquelyn’s RE/MAX Revolution search in a new tab)</span>
            </a>
          )}
          <a href={withBase(`/buy/${town ? `?town=${encodeURIComponent(town)}` : ''}#buyer-inquiry`)} class={listingsUrl ? 'btn-outline' : 'btn-primary'}>
            Send Me Matching Homes
          </a>
        </div>
      </div>
    )
  }
</section>

<script>
  // Lazy-inject vendor IDX scripts when the widget nears the viewport.
  const widgets = document.querySelectorAll<HTMLElement>('.idx-widget[data-idx-src]');
  const load = (el: HTMLElement) => {
    const s = document.createElement('script');
    s.src = el.dataset.idxSrc!;
    s.async = true;
    if (el.dataset.idxWidget) s.dataset.widgetId = el.dataset.idxWidget;
    if (el.dataset.idxCity) s.dataset.city = el.dataset.idxCity;
    el.replaceChildren(s);
  };
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && (io.unobserve(e.target), load(e.target as HTMLElement))),
      { rootMargin: '400px' },
    );
    widgets.forEach((w) => io.observe(w));
  } else {
    widgets.forEach(load);
  }
</script>
