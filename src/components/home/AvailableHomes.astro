---
/**
 * Explore Available Homes: three live MLS listings from an approved IDX feed
 * (src/data/available-homes.ts). Renders nothing until real data exists.
 */
import ListingCard from '@/components/listings/ListingCard.astro';
import { availableHomes, idxDisclaimer } from '@/data/available-homes';
import { withBase } from '@/lib/paths';

const items = availableHomes.filter((l) => l.source === 'mls' && l.url && l.listingBrokerage && !l.demo).slice(0, 3);
const browseHref = withBase('/buy/#home-search');
const external = browseHref.startsWith('http');
---

{
  items.length > 0 && (
    <section class="py-16 sm:py-24" aria-labelledby="available-heading">
      <div class="container-page">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="eyebrow">For Sale Now</p>
            <h2 id="available-heading" class="mt-3 text-3xl sm:text-4xl">Explore Available Homes</h2>
          </div>
          <a href={browseHref} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} class="font-semibold text-navy underline decoration-gold underline-offset-8 hover:decoration-navy">
            See all homes for sale <span aria-hidden="true">→</span>
            {external && <span class="sr-only"> (opens in a new tab)</span>}
          </a>
        </div>
        <div class="mt-10 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((l) => <ListingCard listing={l} />)}
        </div>
        {idxDisclaimer && <p class="mt-10 text-xs text-muted">{idxDisclaimer}</p>}
      </div>
    </section>
  )
}
