---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LeadForm from '@/components/forms/LeadForm.astro';
import Testimonials from '@/components/home/Testimonials.astro';
import { site } from '@/data/site';
---

<BaseLayout
  title="Free Home Valuation | What's My Home Worth? Manalapan, Brick, Point Pleasant, Manahawkin"
  description={`Get a free, accurate home value report from a local REALTOR® with ${site.agent.yearsExperience} years of experience in Monmouth & Ocean County, NJ. No obligation.`}
>
  <section class="bg-gradient-to-br from-brand-900 to-brand-600 py-14 sm:py-20">
    <div class="container-page grid items-center gap-12 lg:grid-cols-2">
      <div class="text-white">
        <p class="eyebrow !text-accent-400">Free · No Obligation · 24-Hour Turnaround</p>
        <h1 class="mt-3 text-4xl leading-tight font-bold !text-white sm:text-5xl">What Is Your Jersey Shore Home Really Worth?</h1>
        <p class="mt-6 text-lg text-brand-100">
          Online estimates can miss by tens of thousands — they can't see your renovated kitchen, your water view, or
          your flood zone. I'll prepare a personal Comparative Market Analysis using actual recent sales on your street.
        </p>
        <ul class="mt-6 space-y-2 text-brand-100">
          <li>✔ Real comps from the MLS — not an algorithm</li>
          <li>✔ Pricing strategy for today's market</li>
          <li>✔ Prep tips that add the most value</li>
        </ul>
      </div>
      <LeadForm variant="valuation" heading="Request Your Free Valuation" id="valuation-page-form" />
    </div>
  </section>
  <Testimonials />
</BaseLayout>
