---
import BrokerageLogo from '@/components/ui/BrokerageLogo.astro';
import { site } from '@/data/site';
import { ui } from '@/i18n/en';
import { isPreview } from '@/lib/mode';
import { withBase } from '@/lib/paths';

const { agent, brokerage, contact, social } = site;
const { address } = brokerage;
const year = new Date().getFullYear();

// NJ advertising disclosure: licensee name, license #, and brokerage. Broker to confirm the wording.
// The brokerage office number stays here only, as plain text: N.J.A.C. 11:5-6.1(d) and (b)2.
const disclosure = [
  `${agent.legalName} is a licensed real estate salesperson (NJ License #${agent.licenseNumber}) affiliated with`,
  `${brokerage.name}, ${address.street}, ${address.city}, ${address.region} ${address.postalCode}.`,
  'Brokerage office:',
]
  .filter(Boolean)
  .join(' ');

const socialLinks = [
  { label: 'Facebook', href: social.facebook },
  { label: 'Instagram', href: social.instagram },
  { label: 'YouTube', href: social.youtube },
  { label: 'Zillow', href: social.zillow },
].filter((s) => s.href);

// Items a broker or attorney should confirm before launch (shown in preview only).
const launchReview = [
  `${brokerage.name} approval of this disclosure (NJ rule 11:5-6.1(b)2 asks for the office number in wording as large as the page's predominant text, unless the site links to the broker's site)`,
  `Her title at ${brokerage.name}`,
  'MLS/IDX disclaimer wording (required once listings are shown)',
  'Privacy policy review',
].filter(Boolean);
---

<footer class="on-dark bg-navy text-navy-soft">
  <div class="container-page grid gap-10 py-12 md:grid-cols-[1fr_auto] md:gap-16">
    <div>
      <p class="font-serif text-2xl text-white">{agent.name}</p>
      <div class="mt-4 w-fit rounded-sm bg-white px-3 py-2.5">
        <BrokerageLogo sizes="(min-width: 640px) 240px, 200px" loading="lazy" class="h-auto w-[12.5rem] sm:w-60" />
      </div>
      <p class="mt-2.5 text-[0.8125rem] leading-5 text-white/85">Each office is independently owned and operated.</p>
      <address class="mt-4 grid gap-x-10 gap-y-3 text-[0.9375rem] not-italic sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2">
        <div class="space-y-1.5">
          <p>{brokerage.name}<br />{address.street}, {address.city}, {address.region} {address.postalCode}</p>
          <p>{agent.firstName}’s NJ License #{agent.licenseNumber}</p>
        </div>
        <div class="space-y-1.5">
          <p>Direct (call or text): <a href={contact.phoneHref} class="whitespace-nowrap text-white underline decoration-white/40 underline-offset-4 hover:decoration-white">{contact.phone}</a></p>
          <p><a href={`mailto:${contact.email}`} class="break-words text-white underline-offset-4 hover:underline">{contact.email}</a></p>
        </div>
      </address>
      {
        socialLinks.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-4">
            {socialLinks.map((s) => (
              <li>
                <a href={s.href} rel="noopener" target="_blank" class="text-white underline-offset-4 hover:underline">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <nav aria-label="Footer">
      <ul class="grid grid-cols-2 gap-x-10 gap-y-2 text-[0.9375rem]">
        <li><a href={withBase('/buy/')} class="hover:text-white">Buying a Home</a></li>
        <li><a href={withBase('/communities/')} class="hover:text-white">Communities</a></li>
        <li><a href={withBase('/sell/')} class="hover:text-white">Selling Your Home</a></li>
        <li><a href={withBase('/reviews/')} class="hover:text-white">Client Reviews</a></li>
        <li><a href={withBase('/buy/#mortgage-calculator')} class="hover:text-white">Mortgage Calculator</a></li>
        <li><a href={withBase('/about/')} class="hover:text-white">{ui.nav.about}</a></li>
        <li><a href={withBase('/contact/')} class="hover:text-white">{ui.nav.contact}</a></li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page space-y-2 py-6 text-xs leading-relaxed sm:text-[0.8125rem]">
      <p>{disclosure} <span class="whitespace-nowrap">{brokerage.officePhone}</span>.</p>
      <!-- Equal Housing Opportunity and the official NAR REALTOR® logo (white reverse for dark
           backgrounds, used unaltered with its clear space) -->
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 pt-3">
        <span class="inline-flex items-center gap-2 font-semibold text-white">
          <svg class="h-9 w-9 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M3 11 12 4l9 7" stroke-linejoin="round"></path><path d="M5 10v10h14V10"></path><path d="M9 14h6M9 17h6"></path>
          </svg>
          Equal Housing Opportunity
        </span>
        <span class="inline-block px-4 py-5">
          <img
            src={withBase('/images/realtor-logo-white.png')}
            width="600"
            height="600"
            alt="REALTOR® — member of the National Association of REALTORS®"
            loading="lazy"
            class="block h-20 w-20"
          />
        </span>
      </div>
      <p class="flex flex-wrap items-center gap-x-5 gap-y-1 pt-1">
        <a href={withBase('/privacy/')} class="text-white underline-offset-4 hover:underline">Privacy</a>
        <a href={withBase('/photo-credits/')} class="text-white underline-offset-4 hover:underline">Photo credits</a>
        <span>&copy; {year} {agent.legalName}</span>
      </p>
      {
        isPreview && (
          <p class="pt-2 text-gold">
            Preview note, confirm before launch: {launchReview.join('; ')}.
          </p>
        )
      }
    </div>
    <p class="border-t border-white/10 py-3 text-center text-[0.75rem] leading-5 text-navy-soft/80">Website by Agent Signature Studio</p>
  </div>
</footer>
