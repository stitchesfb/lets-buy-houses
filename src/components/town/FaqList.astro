---
import type { Faq } from '@/data/towns';

interface Props {
  heading: string;
  faqs: Faq[];
}
const { heading, faqs } = Astro.props;
---

<section aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="text-3xl">{heading}</h2>
  <div class="mt-6 divide-y divide-slate-200 rounded-2xl ring-1 ring-slate-200">
    {
      faqs.map((f) => (
        <details class="group p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-brand-900 [&::-webkit-details-marker]:hidden">
            <h3 class="font-sans text-lg">{f.question}</h3>
            <span class="text-2xl text-brand-500 transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 leading-relaxed text-slate-700">{f.answer}</p>
        </details>
      ))
    }
  </div>
</section>
