---
/**
 * Photographic community tiles. Homepage: six featured towns and a link to the
 * full directory on /communities/. Pass `items` for a specific set (e.g. nearby towns).
 */
import CommunityTile from '@/components/town/CommunityTile.astro';
import { featuredTowns, serviceAreas, type Town } from '@/data/towns';
import { withBase } from '@/lib/paths';

interface Props {
  heading?: string;
  eyebrow?: string;
  items?: Town[];
}
const { heading = 'Explore the communities', eyebrow = 'Communities', items = featuredTowns() } = Astro.props;
---

<section class="py-16 sm:py-24" aria-labelledby="communities-heading">
  <div class="container-page">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2 id="communities-heading" class="mt-3 text-3xl sm:text-4xl">{heading}</h2>
      </div>
      <a href={withBase('/communities/')} class="font-semibold text-navy underline decoration-gold underline-offset-8 hover:decoration-navy">
        All {serviceAreas.length} communities <span aria-hidden="true">→</span>
      </a>
    </div>
    <ul class:list={['mt-10 grid grid-cols-2 gap-3 sm:gap-5', items.length % 3 === 0 ? 'lg:grid-cols-3' : 'lg:grid-cols-4']}>
      {items.map((t) => <li><CommunityTile town={t} sizes={items.length % 3 === 0 ? undefined : '(min-width: 1024px) 25vw, 50vw'} /></li>)}
    </ul>
  </div>
</section>
