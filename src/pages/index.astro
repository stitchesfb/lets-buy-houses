---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import MeetJacquelyn from '@/components/home/MeetJacquelyn.astro';
import Paths from '@/components/home/Paths.astro';
import FeaturedListings from '@/components/home/FeaturedListings.astro';
import HomeTransformations from '@/components/about/HomeTransformations.astro';
import CommunityGrid from '@/components/home/CommunityGrid.astro';
import Testimonials from '@/components/home/Testimonials.astro';
import VideoHub from '@/components/home/VideoHub.astro';
import SellerBand from '@/components/home/SellerBand.astro';
import ContactSection from '@/components/home/ContactSection.astro';
import { site } from '@/data/site';
import { videos } from '@/data/videos';

const title = `${site.agent.legalName} | Toms River, Brick & Jersey Shore Real Estate`;
const description = `Jacquelyn Guevara of ${site.brokerage.name} helps buyers and sellers in Toms River, Brick, Manahawkin, Point Pleasant, Seaside Heights, Beach Haven, and more Ocean and Monmouth County towns. Licensed for over 15 years.`;
const hasVideos = videos.some((v) => v.id);
---

<BaseLayout title={title} description={description} image="/images/jacquelyn-guevara.jpg" overlayHeader>
  <Hero />
  <MeetJacquelyn />
  <Paths />
  <FeaturedListings />
  <HomeTransformations />
  <CommunityGrid />
  <Testimonials />
  {hasVideos && <VideoHub />}
  <SellerBand />
  <ContactSection formId="home-contact" />
</BaseLayout>
