---
import '@fontsource-variable/inter';
import { withBase } from '@/lib/paths';
import '@fontsource-variable/playfair-display';
import '@/styles/global.css';

import SEO from '@/components/seo/SEO.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import MobileCtaBar from '@/components/layout/MobileCtaBar.astro';
import { site } from '@/data/site';
import { realEstateAgentSchema, websiteSchema } from '@/lib/schema';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  /** Page-specific JSON-LD, merged with the sitewide agent + website schema. */
  schema?: object[];
  /** Homepage: transparent header over the hero photo on desktop. */
  overlayHeader?: boolean;
}

const { title, description, image, noindex, schema = [], overlayHeader = false } = Astro.props;
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#14283f" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
        <SEO title={title} description={description} image={image} noindex={noindex} />
    <JsonLd schema={[realEstateAgentSchema(), websiteSchema(), ...schema]} />
    <slot name="head" />
    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </>
      )
    }
  </head>
  <body class="flex min-h-screen flex-col pb-[calc(3.5rem+env(safe-area-inset-bottom))] md:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2">
      Skip to content
    </a>
    <Header overlay={overlayHeader} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MobileCtaBar />
  </body>
</html>
