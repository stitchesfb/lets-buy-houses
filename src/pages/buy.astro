---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Steps from '@/components/ui/Steps.astro';
import IdxSearch from '@/components/idx/IdxSearch.astro';
import LeadForm from '@/components/forms/LeadForm.astro';
import MortgageCalculator from '@/components/tools/MortgageCalculator.astro';
import FeaturedListings from '@/components/home/FeaturedListings.astro';
import CommunityGrid from '@/components/home/CommunityGrid.astro';
import { breadcrumbSchema } from '@/lib/schema';
import { site } from '@/data/site';
import { listingsUrl } from '@/lib/listings-links';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Buy', url: '/buy/' },
];

const steps = [
  {
    title: 'Start with a conversation',
    body: 'Talk through what you need: the towns you’re considering, your budget, timing, and the features that matter most. If you’ll finance, it helps to speak with a lender early about pre-approval.',
  },
  {
    title: 'Search with focus',
    body: 'Jacquelyn sends homes that match your list and helps you compare neighborhoods, commutes, and the trade-offs between them.',
  },
  {
    title: 'Tour and evaluate',
    body: 'Visit homes with someone who knows what to look at, from layout and condition to questions about flood zones, taxes, and upkeep.',
  },
  {
    title: 'Make a strong offer',
    body: 'Jacquelyn reviews recent sales with you, helps you decide on price and terms, and negotiates on your behalf.',
  },
  {
    title: 'Inspections, appraisal, and attorney review',
    body: 'She coordinates the steps after your offer is accepted and keeps you informed about every deadline along the way.',
  },
  {
    title: 'Closing day',
    body: 'A final walkthrough, the signing, and the keys. Jacquelyn stays with you through the finish.',
  },
];
---

<BaseLayout
  title={`Buying a Home in Toms River, Brick & Ocean County, NJ | ${site.agent.legalName}`}
  description={`How Jacquelyn Guevara of ${site.brokerage.name} helps buyers search, tour, negotiate, and close on homes in Ocean and Monmouth County, NJ.`}
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHeader
    crumbs={crumbs}
    eyebrow="Buying a Home"
    title="Find the home that fits your next chapter"
    intro="Buying a home is a big decision. Jacquelyn helps you search with focus, understand each neighborhood, and move confidently from first showing to closing."
  >
    <a href="#buyer-inquiry" class="btn-primary">Start My Home Search</a>
    <a href="#home-search" class="btn-outline">Browse Homes</a>
    <a href="#mortgage-calculator" class="btn-outline">Payment Calculator</a>
  </PageHeader>

  <section class="section" aria-labelledby="buy-steps-heading">
    <div class="container-page">
      <SectionHeading id="buy-steps-heading" eyebrow="The Process" title="How buying with Jacquelyn works" />
      <div class="mt-12"><Steps steps={steps} /></div>
    </div>
  </section>

  <MortgageCalculator />

  <section id="home-search" class="section bg-white/60 pt-0 sm:pt-0" aria-label="Home search">
    <div class="container-page pt-16 sm:pt-20">
      <IdxSearch heading="Search homes for sale" minHeight={900} listingsUrl={listingsUrl()} />
    </div>
  </section>

  <FeaturedListings />

  <section id="buyer-inquiry" class="section bg-ivory-deep" aria-labelledby="buyer-inquiry-heading">
    <div class="container-page grid gap-10 lg:grid-cols-[5fr_7fr] lg:gap-16">
      <SectionHeading
        id="buyer-inquiry-heading"
        eyebrow="Your Home Search"
        title="Tell Jacquelyn what you’re looking for"
        intro="A few details are all she needs to start. She’ll follow up to learn more and send homes that fit."
      />
      <div class="card p-6 sm:p-8">
        <LeadForm variant="buyer" id="buyer-form" />
      </div>
    </div>
  </section>

  <CommunityGrid heading="Explore the towns" />
</BaseLayout>
