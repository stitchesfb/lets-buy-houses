---
import type { Town } from '@/data/towns';
import { withBase } from '@/lib/paths';

interface Props {
  town: Town;
}
const { town } = Astro.props;
const enc = encodeURIComponent(town.name);
const blocks = [
  { id: 'buyer-tips', eyebrow: 'For Buyers', title: `Buying in ${town.name}`, tips: town.buyerTips, cta: 'Send Me Matching Homes', href: `/buy/?town=${enc}#buyer-inquiry`, tone: 'bg-white' },
  { id: 'seller-tips', eyebrow: 'For Sellers', title: `Selling in ${town.name}`, tips: town.sellerTips, cta: 'Request a Home Value Review', href: '/sell/#home-value', tone: 'bg-ivory-deep' },
];
---

<div class="grid gap-6 md:grid-cols-2">
  {
    blocks.map((b) => (
      <section aria-labelledby={`${b.id}-heading`} class:list={['card flex flex-col p-6 sm:p-7', b.tone]}>
        <p class="eyebrow">{b.eyebrow}</p>
        <h2 id={`${b.id}-heading`} class="mt-2 text-2xl">{b.title}</h2>
        <ul class="mt-5 flex-1 space-y-4">
          {b.tips.map((tip) => (
            <li class="flex gap-3">
              <span class="mt-2.5 h-px w-4 shrink-0 bg-gold" aria-hidden="true" />
              <span>{tip}</span>
            </li>
          ))}
        </ul>
        <a href={withBase(b.href)} class="btn-outline mt-6 self-start">{b.cta}</a>
      </section>
    ))
  }
</div>
