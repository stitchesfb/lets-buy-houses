---
/** Two equal, clearly different paths: buying and selling. */
import Photo from '@/components/ui/Photo.astro';
import { photo } from '@/data/photos';
import { withBase } from '@/lib/paths';

const paths = [
  {
    eyebrow: 'Buying a Home',
    title: 'Find the right home, with a guide beside you',
    body: 'Jacquelyn helps you narrow the search, understand each neighborhood, tour with a clear eye, and negotiate an offer you feel good about, then keeps every step moving through closing.',
    cta: 'Explore Buying',
    href: '/buy/',
    photo: photo('path-buy'),
    tone: 'bg-white',
  },
  {
    eyebrow: 'Selling Your Home',
    title: 'Prepare, price, and market with confidence',
    body: 'From getting your home ready to pricing it against recent nearby sales and marketing it well, Jacquelyn handles the details and negotiates for the strongest possible outcome.',
    cta: 'Request a Home Value Review',
    href: '/sell/#home-value',
    photo: photo('path-sell'),
    tone: 'bg-ivory-deep',
  },
];
---

<section class="section bg-white/50 pt-0 sm:pt-0" aria-label="Buying and selling">
  <div class="container-page grid gap-6 md:grid-cols-2">
    {
      paths.map((p) => (
        <article class:list={['card flex flex-col overflow-hidden', p.tone]}>
          {p.photo ? (
            <div class="aspect-[16/9] overflow-hidden">
              <Photo photo={p.photo} aspect="16 / 9" sizes="(min-width: 768px) 45vw, 92vw" widths={[480, 800, 1200]} />
            </div>
          ) : (
            <span class="mx-6 mt-6 block h-1 w-16 bg-gold sm:mx-8 sm:mt-8" aria-hidden="true" />
          )}
          <div class="flex flex-1 flex-col p-6 sm:p-8">
            <p class="eyebrow">{p.eyebrow}</p>
            <h2 class="mt-3 text-2xl sm:text-3xl">{p.title}</h2>
            <p class="mt-4 flex-1 text-muted">{p.body}</p>
            <a href={withBase(p.href)} class="btn-primary mt-7 self-start">{p.cta}</a>
          </div>
        </article>
      ))
    }
  </div>
</section>
