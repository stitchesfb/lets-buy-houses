---
/**
 * Lead form: general contact, home value review, or buyer inquiry.
 *
 * Submissions go to PUBLIC_FORM_ENDPOINT (Formspree, Basin, a CRM webhook, …),
 * which decides where the email is delivered. With no endpoint the form is
 * clearly marked preview-only and never pretends to have sent anything.
 * Behaviour (validation, sending, error, success) lives in src/lib/lead-form.ts.
 */
import Field from './Field.astro';
import { site } from '@/data/site';
import { towns } from '@/data/towns';
import { ui } from '@/i18n/en';
import { formEndpoint } from '@/lib/mode';

type Variant = 'contact' | 'home-value' | 'buyer';

interface Props {
  variant?: Variant;
  /** Unique per page; prefixes every field id. */
  id: string;
  /** Pre-select a town (e.g. on a community page). */
  town?: string;
  submitLabel?: string;
  /** Render for a navy background. */
  dark?: boolean;
}

const { variant = 'contact', id, town, dark = false } = Astro.props;
const submitLabel =
  Astro.props.submitLabel ??
  { contact: 'Send Message', 'home-value': 'Request My Home Value Review', buyer: 'Send My Home Search' }[variant];

const townOptions = [
  { value: '', label: 'Not sure yet' },
  ...towns.map((t) => ({ value: t.name, label: `${t.name}, NJ` })),
  { value: 'Other', label: 'Somewhere else' },
];
const { phone, phoneHref, smsHref, email } = site.contact;
---

<form
  id={id}
  method="post"
  action={formEndpoint || undefined}
  novalidate
  data-lead-form
  data-endpoint={formEndpoint}
  class:list={['grid gap-5 sm:grid-cols-2', dark && 'on-dark']}
>
  <input type="hidden" name="form_type" value={variant} />
  <input type="hidden" name="source_page" value={Astro.url.pathname} />
  <input type="hidden" name="attribution" value="" data-attribution />
  <div class="hidden" aria-hidden="true">
    <label>Leave this field blank <input name="company_website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <p class="hidden rounded-md border border-red-700/30 bg-red-50 p-3 text-sm font-medium text-red-800 sm:col-span-2" role="alert" data-error-summary>
    {ui.form.errors.summary}
  </p>

  {
    variant === 'home-value' && (
      <Field form={id} name="address" label="Property address" required autocomplete="street-address" class="sm:col-span-2" />
    )
  }

  <Field form={id} name="name" label="Your name" required autocomplete="name" class="sm:col-span-2" />
  <Field form={id} name="email" label="Email" type="email" required autocomplete="email" />
  <Field form={id} name="phone" label="Phone" type="tel" autocomplete="tel" />

  {
    variant === 'contact' && (
      <>
        <Field
          form={id}
          name="interest"
          label="I’m interested in"
          type="select"
          class="sm:col-span-2"
          options={[
            { value: 'Buying', label: 'Buying a home' },
            { value: 'Selling', label: 'Selling a home' },
            { value: 'Buying and selling', label: 'Buying and selling' },
            { value: 'Something else', label: 'Something else' },
          ]}
        />
        <Field form={id} name="message" label="How can I help?" type="textarea" class="sm:col-span-2" />
      </>
    )
  }

  {
    variant === 'buyer' && (
      <>
        <Field form={id} name="town" label="Where are you looking?" type="select" options={townOptions} value={town} />
        <Field
          form={id}
          name="budget"
          label="Price range"
          type="select"
          options={[
            { value: '', label: 'Not sure yet' },
            { value: 'Under $400K', label: 'Under $400K' },
            { value: '$400K–$600K', label: '$400K–$600K' },
            { value: '$600K–$800K', label: '$600K–$800K' },
            { value: '$800K–$1M', label: '$800K–$1M' },
            { value: '$1M+', label: '$1M+' },
          ]}
        />
        <Field form={id} name="message" label="What matters most in your next home?" type="textarea" class="sm:col-span-2" />
      </>
    )
  }

  <div class="sm:col-span-2">
    {
      !formEndpoint && (
        <p class="mb-4 rounded-md border border-dashed border-gold-700/60 bg-gold-200/40 p-3 text-sm text-ink" data-preview-notice>
          {ui.form.previewNotice}
        </p>
      )
    }
    <button type="submit" class:list={['w-full text-lg sm:w-auto', dark ? 'btn-light' : 'btn-primary']} data-submit>
      <span data-submit-label>{submitLabel}</span>
    </button>
    <p class:list={['mt-4 text-xs leading-relaxed', dark ? 'text-navy-soft' : 'text-muted']}>{ui.form.consent}</p>
  </div>

  <!-- Result panels: lead-form.ts reveals exactly one after a submit attempt -->
  <div class="hidden rounded-md border border-red-700/30 bg-red-50 p-4 text-ink sm:col-span-2" role="alert" data-result="error">
    <p>{ui.form.errors.network}</p>
    <p class="mt-2 font-semibold"><a href={phoneHref} class="underline">{phone}</a> · <a href={`mailto:${email}`} class="break-all underline">{email}</a></p>
  </div>
  <div class="hidden rounded-md border border-gold-700/40 bg-white p-4 text-ink sm:col-span-2" role="status" tabindex="-1" data-result="preview">
    <p class="font-semibold">{ui.form.previewResult}</p>
    <p class="mt-2">
      Call <a href={phoneHref} class="font-semibold underline">{phone}</a>, text <a href={smsHref} class="font-semibold underline">{phone}</a>,
      or email <a href={`mailto:${email}`} class="font-semibold break-all underline">{email}</a>.
    </p>
  </div>
</form>

<div class="hidden rounded-xl border border-line bg-white p-6 text-ink" role="status" tabindex="-1" data-success-for={id}>
  <p class="font-serif text-2xl text-navy">{ui.form.successTitle}</p>
  <p class="mt-2">{ui.form.successBody}</p>
  <p class="mt-3 font-semibold"><a href={phoneHref} class="underline">{phone}</a></p>
</div>

{!formEndpoint && <noscript><p class="mt-3 text-sm">This preview form needs JavaScript. Please call or email me instead.</p></noscript>}

<script>
  import { initLeadForms } from '@/lib/lead-form';
  initLeadForms();
</script>
