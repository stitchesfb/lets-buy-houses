---
/**
 * Community cards. By default shows the featured towns plus a compact list of
 * every service area; pass `items` to show a specific set (e.g. nearby towns).
 */
import CommunityCard from '@/components/town/CommunityCard.astro';
import ServiceAreaList from '@/components/town/ServiceAreaList.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { featuredTowns, serviceAreas, type Town } from '@/data/towns';
import { withBase } from '@/lib/paths';

interface Props {
  heading?: string;
  intro?: string;
  items?: Town[];
  /** Show the full service-area list and a "View all communities" link. */
  showAllAreas?: boolean;
}
const {
  heading = 'Explore the communities Jacquelyn serves',
  intro = 'Housing, getting around, and local resources in each town, with links to start your search.',
  items = featuredTowns(),
  showAllAreas = !Astro.props.items,
} = Astro.props;
---

<section class="section bg-white/60" aria-labelledby="communities-heading">
  <div class="container-page">
    <SectionHeading id="communities-heading" eyebrow="Communities" title={heading} intro={intro || undefined} />
    <ul class:list={['mt-10 grid gap-6 sm:grid-cols-2', items.length >= 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
      {items.map((t) => <li><CommunityCard town={t} /></li>)}
    </ul>
    {
      showAllAreas && (
        <div class="mt-12 rounded-xl border border-line bg-white p-6 sm:p-8">
          <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
            <h3 class="text-2xl">All {serviceAreas.length} service areas</h3>
            <a href={withBase('/communities/')} class="btn-outline self-start sm:self-auto">View All Communities</a>
          </div>
          <ServiceAreaList class="mt-6" />
        </div>
      )
    }
  </div>
</section>
