---
/** Numbered process steps with a thin gold timeline. */
interface Props {
  steps: { title: string; body: string }[];
}
const { steps } = Astro.props;
---

<ol class="grid gap-x-10 gap-y-8 md:grid-cols-2">
  {
    steps.map((s, i) => (
      <li class="relative border-l border-gold/60 pl-6">
        <span class="absolute top-0 -left-[0.8rem] flex h-6 w-6 items-center justify-center rounded-full bg-navy text-xs font-semibold text-white">
          {i + 1}
        </span>
        <h3 class="text-xl sm:text-2xl">{s.title}</h3>
        <p class="mt-2 text-muted">{s.body}</p>
      </li>
    ))
  }
</ol>
