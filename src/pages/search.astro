---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/paths';
import IdxSearch from '@/components/idx/IdxSearch.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import { towns } from '@/data/towns';
import { idxConfig, toCityList } from '@/lib/idx';
import { breadcrumbSchema } from '@/lib/schema';

// Town slug → MLS city names, so ?town=manahawkin-nj expands to every spelling.
const townCities = Object.fromEntries(towns.map((t) => [t.slug, toCityList(t.idxCity)]));

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Search Homes', url: '/search/' },
];
---

<BaseLayout
  title="Search Homes for Sale in Monmouth & Ocean County, NJ | MLS Listings"
  description="Search every MLS listing in Manalapan, Brick, Point Pleasant, Manahawkin and surrounding Jersey Shore towns. Updated throughout the day."
  schema={[breadcrumbSchema(crumbs)]}
>
  <div class="container-page py-10">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-4 text-4xl font-bold">Search Jersey Shore &amp; Central NJ Homes for Sale</h1>
    <p class="mt-2 text-slate-600">
      Browse by town:
      {towns.map((t, i) => <>{i > 0 && ' · '}<a href={withBase(`/${t.slug}/`)} class="font-medium text-brand-600 hover:underline">{t.name}</a></>)}
    </p>
    <div
      class="mt-8"
      data-idx-forward={idxConfig.provider}
      data-idx-towns={JSON.stringify(townCities)}
      data-idx-city-param={idxConfig.cityParam}
    >
      <IdxSearch minHeight={900} />
    </div>
  </div>
</BaseLayout>

<script>
  /**
   * Forwards hero quick-search params (?town=&max=&beds=) into the IDX iframe.
   * `town` (a slug) expands to one city param per MLS spelling, e.g.
   *   city[]=Manahawkin&city[]=Stafford+Township&city[]=Stafford+Twp
   * Map max/beds to your vendor's query-string names in IDX_PARAM_MAP;
   * the city param name comes from PUBLIC_IDX_CITY_PARAM.
   */
  const IDX_PARAM_MAP: Record<string, string> = { max: 'maxPrice', beds: 'minBeds' };
  const params = new URLSearchParams(location.search);
  const wrapper = document.querySelector<HTMLElement>('[data-idx-forward]');
  const iframe = wrapper?.querySelector<HTMLIFrameElement>('iframe');
  if (wrapper && iframe && [...params.keys()].length) {
    const url = new URL(iframe.src);
    const townCities: Record<string, string[]> = JSON.parse(wrapper.dataset.idxTowns ?? '{}');
    const cityParam = wrapper.dataset.idxCityParam ?? 'city[]';
    const cities = townCities[params.get('town') ?? ''] ?? [];
    if (cities.length) {
      url.searchParams.delete(cityParam);
      cities.forEach((c) => url.searchParams.append(cityParam, c));
    }
    for (const [ours, theirs] of Object.entries(IDX_PARAM_MAP)) {
      const v = params.get(ours);
      if (v) url.searchParams.set(theirs, v);
    }
    iframe.src = url.href;
  }
</script>
