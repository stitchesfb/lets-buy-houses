---
/**
 * Compact review excerpts (exact words, "…" marks omissions) with attribution,
 * source, and a link to the full review. Hidden on the live site until at
 * least one review has its text.
 */
import AwaitingContent from '@/components/ui/AwaitingContent.astro';
import { pendingTestimonials, publishedTestimonials, reviewId, reviewSummary } from '@/data/testimonials';
import { isPreview } from '@/lib/mode';
import { withBase } from '@/lib/paths';

const all = publishedTestimonials();
const quotes = [...all.filter((t) => t.featured), ...all.filter((t) => !t.featured)].slice(0, 3);
const pending = pendingTestimonials();
const platforms = reviewSummary.platforms;
const platformList = `${platforms.slice(0, -1).join(', ')}, and ${platforms.at(-1)}`;
---

{
  quotes.length > 0 && (
    <section class="border-y border-line bg-white/70 py-16 sm:py-20" aria-labelledby="testimonials-heading">
      <div class="container-page">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="eyebrow">Client Reviews</p>
            <h2 id="testimonials-heading" class="mt-3 text-3xl sm:text-4xl">{reviewSummary.total} five-star reviews</h2>
            <p class="mt-3 flex flex-wrap items-center gap-x-3 text-muted">
              <span class="tracking-widest text-gold-700" role="img" aria-label={`${reviewSummary.rating} out of 5 stars`}>{'★'.repeat(reviewSummary.rating)}</span>
              From verified clients on {platformList}
            </p>
          </div>
          <a href={withBase('/reviews/')} class="font-semibold whitespace-nowrap text-navy underline decoration-gold underline-offset-8 hover:decoration-navy">
            View All Reviews <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="mt-12 grid items-start gap-10 md:grid-cols-3 md:gap-8">
          {quotes.map((t) => (
            <figure class="border-t-2 border-gold pt-6">
              <blockquote class="font-serif text-xl leading-snug text-navy">“{t.excerpt ?? t.quote}”</blockquote>
              <figcaption class="mt-5 text-sm">
                <span class="font-semibold text-ink">{t.name}</span>
                {t.town && <span class="text-muted"> · {t.town}</span>}
                <span class="mt-1 block text-muted">
                  {t.source && `${t.source}`}{t.date && ` · ${t.date}`}
                </span>
                <a href={withBase(`/reviews/#${reviewId(t)}`)} class="mt-3 inline-block font-semibold text-navy underline decoration-gold underline-offset-4 hover:decoration-navy">
                  Read full review<span class="sr-only"> from {t.name}</span>
                </a>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}
{
  isPreview && pending.length > 0 && (
    <section class="py-12" aria-label="Client reviews awaiting text">
      <div class="container-page">
        <AwaitingContent title={`${pending.length} client review${pending.length > 1 ? 's' : ''} waiting for their text`}>
          <p>{pending.map((t) => t.name).join(', ')}</p>
        </AwaitingContent>
      </div>
    </section>
  )
}
