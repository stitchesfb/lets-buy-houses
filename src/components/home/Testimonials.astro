---
/** Genuine testimonials only. Hidden on the live site when there are none. */
import AwaitingContent from '@/components/ui/AwaitingContent.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { testimonials } from '@/data/testimonials';
import { isPreview } from '@/lib/mode';

const quotes = testimonials.slice(0, 3);
---

{
  quotes.length > 0 ? (
    <section class="section bg-white/60" aria-labelledby="testimonials-heading">
      <div class="container-page">
        <SectionHeading id="testimonials-heading" eyebrow="Client Stories" title="In their words" />
        <div class:list={['mt-10 grid gap-6', quotes.length > 1 && 'md:grid-cols-2', quotes.length > 2 && 'lg:grid-cols-3']}>
          {quotes.map((t) => (
            <figure class="card flex flex-col p-7">
              <span class="font-serif text-5xl leading-none text-gold" aria-hidden="true">“</span>
              <blockquote class="mt-2 flex-1 text-lg">{t.quote}</blockquote>
              <figcaption class="mt-6 border-t border-line pt-4 text-sm">
                <span class="font-semibold text-ink">{t.name}</span>
                {t.context && <span class="text-muted"> · {t.context}</span>}
                {t.source && <span class="block text-muted">{t.source}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  ) : (
    isPreview && (
      <section class="section bg-white/60 py-12 sm:py-16" aria-label="Client testimonials (awaiting content)">
        <div class="container-page">
          <AwaitingContent title="Client testimonials">
            <p>
              Two or three genuine quotes from past clients go here, with their permission. Add them to{' '}
              <code class="text-sm">src/data/testimonials.ts</code>. This section stays hidden on the live site until then.
            </p>
          </AwaitingContent>
        </div>
      </section>
    )
  )
}
