---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CommunityGrid from '@/components/home/CommunityGrid.astro';
import ContactSection from '@/components/home/ContactSection.astro';
import { breadcrumbSchema } from '@/lib/schema';
import { site } from '@/data/site';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Communities', url: '/communities/' },
];
---

<BaseLayout
  title={`Communities: Toms River, Brick, Manahawkin, Whiting & More | ${site.agent.legalName}`}
  description="Local guides to Toms River, Brick, Manahawkin, Whiting, Tinton Falls, Point Pleasant, and Manalapan, NJ from Jacquelyn Guevara of RE/MAX Revolution: housing, getting around, local resources, and homes for sale."
  schema={[breadcrumbSchema(crumbs)]}
>
  <CommunityGrid asPageTitle heading="Communities Jacquelyn serves" />
  <ContactSection formId="communities-contact" />
</BaseLayout>
