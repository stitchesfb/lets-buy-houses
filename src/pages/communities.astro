---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import CommunityCard from '@/components/town/CommunityCard.astro';
import ServiceAreaList from '@/components/town/ServiceAreaList.astro';
import ContactSection from '@/components/home/ContactSection.astro';
import { serviceAreas, towns } from '@/data/towns';
import { breadcrumbSchema } from '@/lib/schema';
import { site } from '@/data/site';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Communities', url: '/communities/' },
];
const counties = ['Ocean County', 'Monmouth County'] as const;
const names = serviceAreas.map((a) => a.name);
---

<BaseLayout
  title={`Communities: Toms River, Brick, Manahawkin & More | ${site.agent.legalName}`}
  description={`Local guides to the New Jersey communities Jacquelyn Guevara of ${site.brokerage.name} serves: ${names.join(', ')}.`}
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHeader
    crumbs={crumbs}
    eyebrow="Communities"
    title="Communities I serve"
    intro={`Housing, getting around, and local resources in ${towns.length} Ocean and Monmouth County communities, with links to current listings in each.`}
  />

  <section class="border-b border-line py-10 sm:py-12" aria-labelledby="directory-heading">
    <div class="container-page">
      <h2 id="directory-heading" class="text-2xl">All {names.length} service areas, A–Z</h2>
      <ServiceAreaList class="mt-5" />
    </div>
  </section>

  {
    counties.map((county) => {
      const list = towns.filter((t) => t.county === county);
      const id = county.toLowerCase().replace(/\s+/g, '-');
      return (
        <section class="section pb-0 sm:pb-0 last-of-type:pb-16 sm:last-of-type:pb-24" aria-labelledby={id}>
          <div class="container-page">
            <div class="flex items-baseline justify-between gap-4 border-b border-line pb-3">
              <h2 id={id} class="text-3xl">{county}</h2>
              <p class="text-muted">{list.length} communities</p>
            </div>
            <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
              {list.map((t) => <li><CommunityCard town={t} /></li>)}
            </ul>
          </div>
        </section>
      );
    })
  }

  <ContactSection formId="communities-contact" />
</BaseLayout>
