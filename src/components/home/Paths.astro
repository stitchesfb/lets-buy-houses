---
/** Two large photographic panels: buying and selling. One action each. */
import Photo from '@/components/ui/Photo.astro';
import { photo } from '@/data/photos';
import { withBase } from '@/lib/paths';

const panels = [
  {
    title: 'Find Your Next Home',
    body: 'A focused search, honest advice on each neighborhood, and a strong offer when it counts.',
    cta: 'Explore Buying',
    href: '/buy/',
    photo: photo('path-buy'),
  },
  {
    title: 'Sell With Confidence',
    body: 'Practical preparation, careful pricing, and determined negotiation from listing to closing.',
    cta: 'Explore Selling',
    href: '/sell/',
    photo: photo('path-sell'),
  },
];
---

<section class="pb-16 sm:pb-24" aria-label="Buying and selling">
  <div class="container-page grid gap-4 md:grid-cols-2 md:gap-6">
    {
      panels.map((p) => (
        <a href={withBase(p.href)} class="group on-dark relative isolate flex min-h-[26rem] flex-col justify-end overflow-hidden rounded-sm text-white sm:min-h-[32rem]">
          <div class="absolute inset-0 -z-10 transition-transform duration-700 group-hover:scale-[1.03]">
            <Photo photo={p.photo} sizes="(min-width: 768px) 50vw, 100vw" widths={[480, 800, 1200, 1600]} />
          </div>
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-navy/90 via-navy/35 to-transparent" />
          <div class="p-7 sm:p-10">
            <h2 class="text-3xl !text-white sm:text-4xl">{p.title}</h2>
            <p class="mt-3 max-w-md text-white/85">{p.body}</p>
            <span class="mt-6 inline-flex items-center gap-2 border-b border-gold pb-1 font-semibold">
              {p.cta} <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>
