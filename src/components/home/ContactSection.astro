---
import LeadForm from '@/components/forms/LeadForm.astro';
import { affiliation, site } from '@/data/site';

interface Props {
  formId?: string;
  /** Render the heading as the page H1 (on /contact/). */
  asPageTitle?: boolean;
  town?: string;
}
const { formId = 'contact-form', asPageTitle = false, town } = Astro.props;
const { contact, brokerage } = site;
const Heading = asPageTitle ? 'h1' : 'h2';
---

<section id="contact" class="scroll-mt-24 py-16 sm:py-20" aria-labelledby={`${formId}-heading`}>
  <div class="container-page grid gap-10 lg:grid-cols-[5fr_7fr] lg:gap-16">
    <div>
      <p class="eyebrow">Contact</p>
      <Heading id={`${formId}-heading`} class:list={['mt-3 text-3xl sm:text-4xl', asPageTitle && 'sm:text-5xl']}>
        {town ? `Questions about ${town}?` : 'Let’s talk about your next move'}
      </Heading>
      <p class="mt-5 text-lg text-muted">Send me a note, or reach me directly. I’d love to hear from you.</p>
      <dl class="mt-8 space-y-5">
        <div>
          <dt class="text-sm font-semibold text-muted">My direct line (call or text)</dt>
          <dd class="mt-1 text-xl">
            <a href={contact.phoneHref} class="text-navy underline decoration-gold underline-offset-4">{contact.phone}</a>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-muted">Email</dt>
          <dd class="mt-1 text-xl break-all">
            <a href={`mailto:${contact.email}`} class="text-navy underline decoration-gold underline-offset-4">{contact.email}</a>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-muted">Office</dt>
          <dd class="mt-1">
            {affiliation}<br />{brokerage.address.street}, {brokerage.address.city}, {brokerage.address.region} {brokerage.address.postalCode}<br />
            Office phone: <a href={brokerage.officePhoneHref} class="text-navy underline decoration-gold underline-offset-4">{brokerage.officePhone}</a>
          </dd>
        </div>
      </dl>
    </div>
    <div class="rounded-sm bg-white p-6 sm:p-8">
      <LeadForm variant="contact" id={formId} />
    </div>
  </div>
</section>
