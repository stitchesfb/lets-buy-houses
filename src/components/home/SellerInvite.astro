---
/** Navy invitation to request a personal home value review. */
import LeadForm from '@/components/forms/LeadForm.astro';

interface Props {
  id?: string;
  formId?: string;
}
const { id = 'home-value', formId = 'home-value-form' } = Astro.props;
---

<section id={id} class="on-dark section bg-navy text-white" aria-labelledby={`${id}-heading`}>
  <div class="container-page grid items-start gap-10 lg:grid-cols-[5fr_6fr] lg:gap-16">
    <div>
      <p class="eyebrow !text-gold">Home Value Review</p>
      <h2 id={`${id}-heading`} class="mt-3 text-3xl !text-white sm:text-4xl">Thinking About Selling?</h2>
      <span class="rule-gold mt-5"></span>
      <p class="mt-6 text-lg text-navy-soft">
        Jackie can look at your home with you, review recent sales nearby, and talk through pricing, preparation, and timing
        so you can decide on next steps with confidence.
      </p>
      <p class="mt-4 text-navy-soft">
        This is a personal review, not an instant online estimate. Share your address and Jackie will reach out to set a time
        that works for you.
      </p>
    </div>
    <div class="rounded-xl bg-white p-6 text-ink sm:p-8">
      <LeadForm variant="home-value" id={formId} />
    </div>
  </div>
</section>
