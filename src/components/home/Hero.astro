---
import { site } from '@/data/site';
import { withBase } from '@/lib/paths';
import QuickSearch from '@/components/idx/QuickSearch.astro';

const { agent } = site;
---

<section class="relative overflow-hidden bg-gradient-to-br from-brand-900 via-brand-700 to-brand-500 text-white">
  <div class="pointer-events-none absolute inset-0 opacity-20 [background:radial-gradient(60rem_30rem_at_80%_-10%,#f5a524,transparent)]" aria-hidden="true"></div>

  <div class="container-page relative grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-[1.25fr_1fr] lg:py-24">
    <div>
      <p class="eyebrow !text-accent-400">{agent.yearsExperience} Years · Jersey Shore &amp; Central NJ</p>
      <h1 class="mt-4 text-4xl leading-tight font-bold !text-white sm:text-5xl lg:text-6xl">
        Your Local Expert for Buying &amp; Selling at the Jersey Shore
      </h1>
      <p class="mt-6 max-w-xl text-lg text-brand-100 sm:text-xl">
        {agent.yearsExperience} years guiding families through Manalapan, Brick, Point Pleasant, and Manahawkin
        real estate — with pricing backed by real local sales, not algorithms.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={withBase('/search/')} class="btn-primary text-lg">Find Your Dream Home</a>
        <a href={withBase('/home-valuation/')} class="btn-ghost-light text-lg">Get a Free Home Valuation</a>
      </div>

      <div class="mt-10 max-w-2xl text-slate-800">
        <QuickSearch />
      </div>
    </div>

    <figure class="relative mx-auto w-full max-w-sm lg:max-w-md">
      <div class="absolute -inset-3 rotate-3 rounded-[2rem] bg-accent-400/30" aria-hidden="true"></div>
      <img
        src={withBase(agent.headshot)}
        alt={`${agent.legalName}, ${agent.title} at ${site.brokerage.name}, serving Monmouth and Ocean County, NJ`}
        width="600"
        height="600"
        fetchpriority="high"
        class="relative aspect-[4/5] w-full rounded-[2rem] object-cover shadow-2xl"
      />
      <figcaption class="absolute -bottom-5 left-1/2 w-max -translate-x-1/2 rounded-full bg-white px-5 py-2 text-sm font-semibold text-brand-900 shadow-lg">
        {agent.name} · {site.brokerage.name}
      </figcaption>
    </figure>
  </div>
</section>
