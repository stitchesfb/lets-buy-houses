---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LeadForm from '@/components/forms/LeadForm.astro';
import AgentCta from '@/components/ui/AgentCta.astro';
import { site } from '@/data/site';
---

<BaseLayout
  title={`Contact ${site.agent.name} | Jersey Shore REALTOR®`}
  description="Call, text, or message a local REALTOR® serving Manalapan, Brick, Point Pleasant, and Manahawkin, NJ. Fast, personal responses."
>
  <div class="container-page grid gap-12 py-14 lg:grid-cols-[1fr_320px]">
    <div>
      <h1 class="text-4xl font-bold">Let's Talk Real Estate</h1>
      <p class="mt-3 text-lg text-slate-600">Most messages get a personal reply within the hour during business hours.</p>
      <div class="mt-8">
        <LeadForm variant="contact" heading="Send a Message" id="contact-page-form" />
      </div>
    </div>
    <div class="lg:pt-20"><AgentCta /></div>
  </div>
</BaseLayout>
