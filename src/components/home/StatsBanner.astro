---
import { site } from '@/data/site';
---

<section class="bg-brand-900 py-12 text-white" aria-label="Experience and results">
  <dl class="container-page grid grid-cols-2 gap-8 text-center lg:grid-cols-4">
    {
      site.stats.map((s) => (
        <div class="flex flex-col-reverse">
          <dt class="mt-1 text-sm tracking-wide text-brand-200 uppercase">{s.label}</dt>
          <dd class="font-display text-4xl font-bold text-accent-400 sm:text-5xl">{s.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
