---
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import AwaitingContent from '@/components/ui/AwaitingContent.astro';
import WhyJacquelyn from '@/components/home/WhyJacquelyn.astro';
import Testimonials from '@/components/home/Testimonials.astro';
import ServiceAreaList from '@/components/town/ServiceAreaList.astro';
import HomeTransformations from '@/components/about/HomeTransformations.astro';
import ContactSection from '@/components/home/ContactSection.astro';
import portrait from '@/assets/jacquelyn-guevara.jpg';
import { affiliation, site } from '@/data/site';
import { breadcrumbSchema } from '@/lib/schema';
import { withBase } from '@/lib/paths';

const { agent, brokerage } = site;
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'About Jacquelyn', url: '/about/' },
];
const facts = [
  { label: 'Team', value: site.team.name },
  { label: 'Brokerage', value: `${brokerage.name}, ${brokerage.address.city}, NJ` },
  { label: 'In real estate', value: `${agent.yearsLicensed} years` },
  { label: 'Ocean County resident', value: `${agent.yearsInOceanCounty} years` },
  { label: 'NJ license', value: `#${agent.licenseNumber}` },
];
---

<BaseLayout
  title={`About ${agent.legalName} | ${affiliation}`}
  description={`Get to know Jacquelyn Guevara: an Ocean County resident for over 35 years with more than 15 years in real estate, now with ${affiliation}.`}
  schema={[breadcrumbSchema(crumbs)]}
>
  <section class="section pt-10 sm:pt-12" aria-labelledby="about-heading">
    <div class="container-page">
      <div class="text-sm text-muted"><Breadcrumbs items={crumbs} /></div>
      <div class="mt-8 grid items-start gap-10 lg:grid-cols-[5fr_7fr] lg:gap-16">
        <div class="lg:sticky lg:top-28">
          <Picture
            src={portrait}
            alt={`Portrait of ${agent.legalName}`}
            widths={[420, 640, 900]}
            sizes="(min-width: 1024px) 34vw, 92vw"
            formats={['avif', 'webp']}
            loading="eager"
            class="aspect-[4/5] w-full max-w-md object-cover object-[50%_30%]"
          />
          <dl class="mt-6 max-w-md divide-y divide-line border-y border-line">
            {
              facts.map((f) => (
                <div class="flex justify-between gap-4 py-3 text-[0.9375rem]">
                  <dt class="text-muted">{f.label}</dt>
                  <dd class="text-right font-semibold text-ink">{f.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div>
          <p class="eyebrow">About Jacquelyn</p>
          <h1 id="about-heading" class="mt-3 text-4xl sm:text-5xl">{agent.name}</h1>
          <p class="mt-2 text-lg text-muted">{affiliation}</p>
          <span class="rule-gold mt-6"></span>
          <p class="mt-6 font-serif text-xl leading-relaxed text-navy sm:text-2xl">{agent.renovation}</p>
          <p class="eyebrow mt-10">My story</p>
          <div class="mt-4 space-y-5 text-lg leading-relaxed">
            {agent.bio.split(/(?<=[.?!])\s+(?=Whether marketing|Over 15\+)/).map((p) => <p>{p}</p>)}
          </div>

          <h2 class="mt-12 text-2xl sm:text-3xl">Where I work</h2>
          <ServiceAreaList class="mt-5" />

          <div class="mt-10 flex flex-col gap-3 sm:flex-row">
            <a href={withBase('/contact/')} class="btn-primary">Schedule a Conversation</a>
            <a href={site.contact.phoneHref} class="btn-outline">Call {site.contact.phone}</a>
          </div>

          <div class="mt-12">
            <AwaitingContent title="More about Jacquelyn">
              <p>
                Optional details to confirm before adding: professional designations, languages spoken, community involvement,
                and a few personal touches (favorite local spots, family, interests). Nothing is shown until confirmed.
              </p>
            </AwaitingContent>
          </div>
        </div>
      </div>
    </div>
  </section>

  <HomeTransformations />
  <WhyJacquelyn />
  <Testimonials />
  <ContactSection formId="about-contact" />
</BaseLayout>
