---
import { site } from '@/data/site';
import { withBase } from '@/lib/paths';
import { towns } from '@/data/towns';

const path = Astro.url.pathname;
const nav = [
  { label: 'Search Homes', href: '/search/' },
  { label: 'Home Value', href: '/home-valuation/' },
  { label: 'Videos', href: '/#videos' },
  { label: 'Contact', href: '/contact/' },
];
---

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/95 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4 lg:h-20">
    <a href={withBase('/')} class="flex items-center gap-2" aria-label={`${site.brand} home`}>
      <img src={withBase('/favicon.svg')} alt="" width="36" height="36" class="h-9 w-9" />
      <span class="font-display text-xl font-bold text-brand-900">{site.brand}</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 lg:flex">
      <div class="group relative">
        <button
          type="button"
          class="rounded-md px-3 py-2 font-medium text-slate-700 hover:text-brand-600"
          aria-haspopup="true"
        >
          Communities ▾
        </button>
        <ul class="invisible absolute top-full left-0 w-60 rounded-xl bg-white p-2 opacity-0 shadow-xl ring-1 ring-slate-200 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
          {
            towns.map((t) => (
              <li>
                <a href={withBase(`/${t.slug}/`)} class="block rounded-lg px-3 py-2 hover:bg-brand-50">
                  <span class="font-semibold text-brand-900">{t.name}, NJ</span>
                  <span class="block text-xs text-slate-500">{t.angle}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      {
        nav.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={[
              'rounded-md px-3 py-2 font-medium hover:text-brand-600',
              path === withBase(item.href) ? 'text-brand-600' : 'text-slate-700',
            ]}
            aria-current={path === withBase(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href={site.contact.phoneHref} class="hidden font-semibold text-brand-700 sm:inline">{site.contact.phone}</a>
      <a href={withBase('/home-valuation/')} class="btn-primary hidden !px-5 !py-2 text-sm md:inline-flex">Free Home Value</a>

      <!-- Mobile menu: <details> works without JavaScript -->
      <details class="relative lg:hidden">
        <summary class="list-none rounded-md p-2 text-brand-900 [&::-webkit-details-marker]:hidden" aria-label="Open menu">
          <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <nav aria-label="Mobile" class="absolute right-0 mt-2 w-72 rounded-2xl bg-white p-3 shadow-2xl ring-1 ring-slate-200">
          <p class="px-3 pt-1 pb-2 text-xs font-semibold tracking-widest text-slate-400 uppercase">Communities</p>
          {towns.map((t) => <a href={withBase(`/${t.slug}/`)} class="block rounded-lg px-3 py-2 font-medium hover:bg-brand-50">{t.name}, NJ</a>)}
          <hr class="my-2 border-slate-200" />
          {nav.map((item) => <a href={withBase(item.href)} class="block rounded-lg px-3 py-2 font-medium hover:bg-brand-50">{item.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>
