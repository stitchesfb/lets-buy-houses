---
/**
 * Community page template → /manalapan-nj/, /brick-nj/, /point-pleasant-nj/, /manahawkin-nj/
 * Content lives in src/data/towns.ts. Add a town there and a page is generated.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Photo from '@/components/ui/Photo.astro';
import IdxSearch from '@/components/idx/IdxSearch.astro';
import MarketStats from '@/components/town/MarketStats.astro';
import FaqList from '@/components/town/FaqList.astro';
import BuySellTips from '@/components/town/BuySellTips.astro';
import AgentCta from '@/components/ui/AgentCta.astro';
import VideoHub from '@/components/home/VideoHub.astro';
import CommunityGrid from '@/components/home/CommunityGrid.astro';
import ContactSection from '@/components/home/ContactSection.astro';
import { nearbyTowns, towns, type Town } from '@/data/towns';
import { photo } from '@/data/photos';
import { videos } from '@/data/videos';
import { breadcrumbSchema, faqSchema, townPageSchema } from '@/lib/schema';
import { withBase } from '@/lib/paths';
import { listingsUrl } from '@/lib/listings-links';

export const getStaticPaths = (() => towns.map((town) => ({ params: { town: town.slug }, props: { town } }))) satisfies GetStaticPaths;

interface Props {
  town: Town;
}
const { town } = Astro.props;

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Communities', url: '/communities/' },
  { name: `${town.name}, NJ`, url: `/${town.slug}/` },
];
const townVideos = videos.filter((v) => v.town === town.slug && v.id);
const heroPhoto = photo(town.photo);
---

<BaseLayout
  title={town.metaTitle}
  description={town.metaDescription}
  schema={[townPageSchema(town), breadcrumbSchema(crumbs), faqSchema(town.faqs)]}
>
  <section class="on-dark relative isolate overflow-hidden bg-navy text-white">
    {
      heroPhoto && (
        <div class="absolute inset-0 -z-10">
          <Photo photo={heroPhoto} eager sizes="100vw" widths={[640, 1024, 1600, 2200]} />
          <div class="absolute inset-0 bg-gradient-to-r from-navy/90 via-navy/70 to-navy/35" />
        </div>
      )
    }
    <div class="container-page py-14 sm:py-20">
      <div class="text-sm text-navy-soft"><Breadcrumbs items={crumbs} /></div>
      <p class="eyebrow mt-8 !text-gold">{town.county} · ZIP {town.zipCodes.join(', ')}</p>
      <h1 class="mt-3 max-w-3xl text-4xl leading-tight !text-white sm:text-5xl">{town.headline}</h1>
      <p class="mt-5 max-w-2xl text-lg text-navy-soft">{town.subheadline}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#homes" class="btn-light">See Homes in {town.name}</a>
        <a href={withBase('/sell/#home-value')} class="btn-ghost-light">Request a Home Value Review</a>
      </div>
    </div>
  </section>

  <div class="container-page grid gap-12 py-14 sm:py-16 lg:grid-cols-[1fr_20rem] lg:gap-16">
    <div class="min-w-0 space-y-16">
      <section aria-labelledby="living-heading">
        <h2 id="living-heading" class="text-3xl">Living in {town.name}</h2>
        <p class="mt-4 text-lg">{town.intro}</p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {
            town.highlights.map((h) => (
              <li class="flex gap-3 rounded-md border border-line bg-white p-4">
                <span class="mt-2.5 h-px w-4 shrink-0 bg-gold" aria-hidden="true" />
                {h}
              </li>
            ))
          }
        </ul>
      </section>

      <MarketStats town={town} />

      <div id="homes">
        <IdxSearch city={town.idxCity} town={town.name} heading={`Homes for sale in ${town.name}`} listingsUrl={listingsUrl(town)} />
      </div>

      <section aria-labelledby="hoods-heading">
        <h2 id="hoods-heading" class="text-3xl">Neighborhoods and home styles</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          {
            town.neighborhoods.map((n) => (
              <div class="card p-5">
                <h3 class="text-xl">{n.name}</h3>
                <p class="mt-2 text-muted">{n.blurb}</p>
              </div>
            ))
          }
        </div>
      </section>

      <BuySellTips town={town} />

      <FaqList heading={`${town.name} real estate questions`} faqs={town.faqs} />
    </div>

    <div class="lg:sticky lg:top-28 lg:self-start">
      <AgentCta town={town.name} />
    </div>
  </div>

  {townVideos.length > 0 && <VideoHub heading={`${town.name} videos`} items={townVideos} />}

  <ContactSection formId={`${town.slug}-contact`} town={town.name} />

  <CommunityGrid eyebrow="Nearby" heading="Explore nearby communities" items={nearbyTowns(town)} />
</BaseLayout>
