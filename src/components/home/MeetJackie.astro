---
import { Picture } from 'astro:assets';
import portrait from '@/assets/jackie-guevara.jpg';
import { site } from '@/data/site';
import { towns } from '@/data/towns';
import { withBase } from '@/lib/paths';

const { agent, brokerage } = site;
const facts = [
  { value: agent.yearsInOceanCounty, label: 'Years living in Ocean County' },
  { value: agent.yearsLicensed, label: `Years licensed with ${brokerage.name}` },
];
---

<section class="section" aria-labelledby="meet-heading">
  <div class="container-page grid items-center gap-10 lg:grid-cols-[5fr_7fr] lg:gap-16">
    <div class="relative mx-auto w-full max-w-md lg:mx-0">
      <span class="absolute -right-3 -bottom-3 h-full w-full bg-ivory-deep sm:-right-5 sm:-bottom-5" aria-hidden="true"></span>
      <Picture
        src={portrait}
        alt={`Portrait of ${agent.legalName}`}
        widths={[420, 640, 900]}
        sizes="(min-width: 1024px) 420px, (min-width: 640px) 28rem, 92vw"
        formats={['avif', 'webp']}
        class="relative aspect-[4/5] w-full object-cover object-[50%_30%]"
      />
    </div>

    <div>
      <p class="eyebrow">Meet Jackie</p>
      <h2 id="meet-heading" class="mt-3 text-3xl sm:text-4xl">A neighbor who knows these streets</h2>
      <span class="rule-gold mt-5"></span>
      <div class="mt-6 space-y-4 text-lg">
        {agent.intro.map((p) => <p>{p}</p>)}
      </div>

      <dl class="mt-8 grid max-w-md grid-cols-2 gap-6 border-y border-line py-6">
        {
          facts.map((f) => (
            <div class="flex flex-col">
              <dt class="text-sm text-muted">{f.label}</dt>
              <dd class="order-first font-serif text-4xl text-navy">{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <p class="mt-6 text-muted">
        <span class="font-semibold text-ink">Areas served:</span>{' '}
        {towns.map((t, i) => <>{i > 0 && ', '}<a href={withBase(`/${t.slug}/`)} class="text-navy underline decoration-gold underline-offset-4 hover:decoration-navy">{t.name}</a></>)}
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={withBase('/about/')} class="btn-primary">Get to Know Jackie</a>
        <a href={withBase('/contact/')} class="btn-outline">Schedule a Conversation</a>
      </div>
    </div>
  </div>
</section>
