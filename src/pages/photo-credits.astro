---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import { creditedPhotos } from '@/data/photos';
import { site } from '@/data/site';

const photos = creditedPhotos();
---

<BaseLayout title={`Photo Credits | ${site.agent.legalName}`} description="Credits and licenses for photographs used on this website.">
  <PageHeader title="Photo credits" intro="Thank you to the photographers whose openly licensed work appears on this site." />
  <section class="section pt-10 sm:pt-12">
    <div class="container-page max-w-3xl">
      {
        photos.length ? (
          <ul class="divide-y divide-line border-y border-line">
            {photos.map((p) => (
              <li class="py-4">
                <a href={p.sourceUrl} rel="noopener" class="font-semibold text-navy underline">{p.title}</a> by {p.author}, licensed under{' '}
                <a href={p.licenseUrl} rel="noopener license" class="underline">{p.license}</a>. Resized and cropped.
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-muted">No third-party photographs are currently in use.</p>
        )
      }
      <p class="mt-6 text-muted">Portrait of {site.agent.legalName} used with permission.</p>
    </div>
  </section>
</BaseLayout>
