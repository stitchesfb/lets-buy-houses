---
import { site } from '@/data/site';
import { towns } from '@/data/towns';
import { ui } from '@/i18n/en';
import { stripBase, withBase } from '@/lib/paths';
import { isPreview } from '@/lib/mode';
import PreviewBanner from '@/components/layout/PreviewBanner.astro';

interface Props {
  /** Transparent over a full-bleed hero on desktop, solid once the page scrolls. */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;

const nav = [
  { label: ui.nav.home, href: '/' },
  { label: ui.nav.buy, href: '/buy/' },
  { label: ui.nav.sell, href: '/sell/' },
  { label: ui.nav.communities, href: '/communities/' },
  { label: ui.nav.about, href: '/about/' },
  { label: ui.nav.contact, href: '/contact/' },
];

const path = stripBase(Astro.url.pathname);
const townPaths = towns.map((t) => `/${t.slug}/`);
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href) || (href === '/communities/' && townPaths.includes(path));
---

<header class="site-header sticky top-0 z-40" data-overlay={overlay ? 'true' : 'false'} data-solid="false">
  {isPreview && <PreviewBanner />}
  <div class="border-b border-line bg-ivory/95 backdrop-blur transition-colors duration-300 supports-[backdrop-filter]:bg-ivory/90 lg:overlay:border-white/15 lg:overlay:bg-transparent lg:overlay:backdrop-blur-none">
  <div class="container-page flex h-16 items-center justify-between gap-4 lg:h-20">
    <a href={withBase('/')} class="group flex flex-col leading-tight" aria-label={`${site.agent.name}, home`}>
      <span class="font-serif text-lg whitespace-nowrap text-navy transition-colors sm:text-xl lg:overlay:text-white">{site.agent.name}</span>
      <span class="text-[0.6875rem] font-semibold tracking-[0.16em] text-muted uppercase transition-colors lg:overlay:text-white/80">{site.brokerage.name}</span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="relative rounded-md px-3 py-2 text-[0.9375rem] font-medium text-ink transition-colors hover:text-navy aria-[current=page]:text-navy lg:overlay:text-white lg:overlay:hover:text-white/75 lg:overlay:aria-[current=page]:text-white aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-3 aria-[current=page]:after:-bottom-0.5 aria-[current=page]:after:h-px aria-[current=page]:after:bg-gold"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={withBase('/contact/')} class="btn-primary hidden !min-h-11 !px-5 !py-2 text-[0.9375rem] sm:inline-flex lg:overlay:bg-white lg:overlay:text-navy lg:overlay:hover:bg-ivory">{ui.nav.cta}</a>
      <button
        type="button"
        class="inline-flex min-h-11 min-w-[5.75rem] items-center justify-center gap-2 rounded-md border border-line bg-white px-3 text-sm font-semibold whitespace-nowrap text-navy lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path data-icon-open stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
          <path data-icon-close class="hidden" stroke-linecap="round" d="M6 6l12 12M18 6 6 18"></path>
        </svg>
        <span data-menu-label>{ui.nav.menu}</span>
      </button>
    </div>
  </div>

  </div>

  <nav id="mobile-menu" aria-label="Mobile" class="border-t border-line bg-ivory lg:hidden" hidden>
    <ul class="container-page divide-y divide-line py-2">
      {
        nav.map((item) => (
          <li>
            <a
              href={withBase(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="flex min-h-12 items-center py-3 text-lg text-ink aria-[current=page]:font-semibold aria-[current=page]:text-navy"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="container-page grid gap-3 pt-2 pb-6 sm:grid-cols-2">
      <a href={withBase('/contact/')} class="btn-primary">{ui.nav.cta}</a>
      <a href={site.contact.phoneHref} class="btn-outline">Call {site.contact.phone}</a>
    </div>
  </nav>
</header>

<script>
  import { ui } from '@/i18n/en';

  // Overlay header: solid once the page scrolls or the menu opens.
  const header = document.querySelector<HTMLElement>('.site-header[data-overlay="true"]');
  const setSolid = (solid: boolean) => header?.setAttribute('data-solid', String(solid));
  if (header) {
    const onScroll = () => setSolid(window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const label = toggle.querySelector('[data-menu-label]');
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
      if (label) label.textContent = open ? ui.nav.close : ui.nav.menu;
      if (header) setSolid(open || window.scrollY > 40);
    };
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
    toggle.addEventListener('click', () => setOpen(!isOpen()));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });
    // Close when following an in-page link
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
  }
</script>
