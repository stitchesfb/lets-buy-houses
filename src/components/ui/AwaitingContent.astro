---
/** Preview-only placeholder for content Jackie still needs to supply. Renders nothing in production. */
import { isPreview } from '@/lib/mode';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

{
  isPreview && (
    <div class="rounded-xl border border-dashed border-gold-700/60 bg-white/60 p-6 text-center sm:p-8">
      <p class="eyebrow">Awaiting content · preview only</p>
      <p class="mt-2 font-serif text-xl text-navy">{title}</p>
      <div class="mx-auto mt-2 max-w-xl text-muted">
        <slot />
      </div>
    </div>
  )
}
