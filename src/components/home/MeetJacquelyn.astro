---
/** Introduction: her real portrait (once on the page), a short intro, compact facts, one link. */
import { Picture } from 'astro:assets';
import portrait from '@/assets/jacquelyn-guevara.jpg';
import { site } from '@/data/site';
import { withBase } from '@/lib/paths';

const { agent, brokerage } = site;
const facts = [
  `${agent.yearsInOceanCounty} years in Ocean County`,
  `${agent.yearsLicensed} years licensed`,
  brokerage.name,
];
---

<section class="py-16 sm:py-24" aria-labelledby="meet-heading">
  <div class="container-page grid items-center gap-10 md:grid-cols-[minmax(0,20rem)_1fr] md:gap-14 lg:grid-cols-[minmax(0,23rem)_1fr] lg:gap-20">
    <Picture
      src={portrait}
      alt={`Portrait of ${agent.legalName}`}
      widths={[320, 480, 720]}
      sizes="(min-width: 1024px) 23rem, (min-width: 768px) 20rem, 18rem"
      formats={['avif', 'webp']}
      class="mx-auto aspect-[4/5] w-full max-w-[18rem] rounded-sm object-cover object-[50%_25%] md:mx-0 md:max-w-none"
    />

    <div class="max-w-2xl">
      <p class="eyebrow">Meet Jacquelyn</p>
      <h2 id="meet-heading" class="mt-3 text-3xl sm:text-4xl">Local roots and hands-on experience</h2>
      <p class="mt-6 text-lg leading-relaxed">{agent.intro[0]}</p>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        I’ve also managed home renovation and resale projects from start to finish, so I can see what a home could become, and what
        it needs before it sells.
      </p>
      <ul class="mt-8 flex flex-col gap-x-6 gap-y-2 border-t sm:flex-row sm:flex-wrap border-line pt-5 text-sm font-semibold tracking-wide text-navy">
        {facts.map((f, i) => <li class="flex items-center gap-6">{i > 0 && <span class="hidden h-1 w-1 rounded-full bg-gold sm:block" aria-hidden="true" />}{f}</li>)}
      </ul>
      <a href={withBase('/about/')} class="mt-8 inline-flex items-center gap-2 font-semibold text-navy underline decoration-gold decoration-2 underline-offset-8 hover:decoration-navy">
        Meet Jacquelyn <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
